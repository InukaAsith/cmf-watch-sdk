#!/usr/bin/env bash
# Builds the iPhone app with the current workout watch app inside and installs it.
#   scripts/ios-install            the iPhone connected to this Mac (free Personal Team: re-run every 7 days)
#   scripts/ios-install --sim      the iOS Simulator (`--sim -tcp 7700`: talk to `wp2apps bridge`, debug only)
# WP2_TEAM: your Apple team id (Xcode > Settings > Accounts); WP2_BUNDLE_ID: a bundle id unique to you.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
nix-shell -p llvm --run "'$root/scripts/build-app' workout ${WP2_WORKOUT_VERSION:-1}" >/dev/null
mkdir -p "$root/ios/Workout/Resources"
cp "$root/target/workout.wp2app" "$root/ios/Workout/Resources/workout.wp2app"
# WP2_LOADER=path/to/loader.wp2app: the Watch tab offers it; empty otherwise (the section stays hidden)
if [ -n "${WP2_LOADER:-}" ]; then cp "$WP2_LOADER" "$root/ios/Workout/Resources/loader.wp2app"
else : > "$root/ios/Workout/Resources/loader.wp2app"; fi
(cd "$root/ios" && nix-shell -p xcodegen --run xcodegen >/dev/null)
# Xcode's tools, not nix-shell's SDK
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
unset SDKROOT DEVELOPER_DIR
cd "$root/ios"
bundle=${WP2_BUNDLE_ID:-local.wp2apps.workout}
if [ "${1:-}" = "--sim" ]; then
    shift
    sim=${WP2_SIM:-iPhone 17e}
    xcodebuild -project Workout.xcodeproj -scheme Workout -destination "platform=iOS Simulator,name=$sim" \
        -derivedDataPath build -quiet build
    xcrun simctl boot "$sim" 2>/dev/null || true
    xcrun simctl install "$sim" build/Build/Products/Debug-iphonesimulator/Workout.app
    xcrun simctl launch "$sim" "$bundle" "$@"
    exit
fi
: "${WP2_TEAM:?set WP2_TEAM to your Apple team id (Xcode > Settings > Accounts > your team)}"
# WP2_DEVICE: the iPhone's identifier when several are paired (`xcrun devicectl list devices`)
device=${WP2_DEVICE:-$(xcrun devicectl list devices 2>/dev/null | grep physical | grep available | grep -m1 -oE '[0-9A-F]{8}-[0-9A-F]{16}')}
[ -n "$device" ] || { echo "no iPhone connected (cable, unlocked, trusted, Developer Mode on)" >&2; exit 1; }
xcodebuild -project Workout.xcodeproj -scheme Workout -configuration Release -destination "id=$device" \
    -derivedDataPath build -allowProvisioningUpdates -quiet \
    DEVELOPMENT_TEAM="$WP2_TEAM" WP2_BUNDLE="$bundle" build
xcrun devicectl device install app --device "$device" build/Build/Products/Release-iphoneos/Workout.app
echo "installed; first launch: Settings > General > VPN & Device Management > trust your developer profile"
