#!/usr/bin/env python3
"""Adds the keys the Swift compiler extracted (SWIFT_EMIT_LOC_STRINGS, *.stringsdata of the last build) to
ios/Workout/Localizable.xcstrings, which only Xcode's IDE updates by itself; prints the keys without English.
  scripts/ios-strings                  add keys, list what lacks "en"
  scripts/ios-strings en.json          also take English values from {"key": "value"}"""
import json
import sys
from pathlib import Path

ios = Path(__file__).resolve().parent.parent / "ios"
catalog = ios / "Workout/Localizable.xcstrings"
data = json.loads(catalog.read_text())
strings = data["strings"]
keys = set()
for f in (ios / "build").rglob("*.stringsdata"):
    if "AppShortcuts" in f.name:
        continue
    for entry in json.loads(f.read_text()).get("tables", {}).get("Localizable", []):
        keys.add(entry["key"])
en = json.loads(Path(sys.argv[1]).read_text()) if len(sys.argv) > 1 else {}
for k in sorted(keys | set(en)):  # en.json may name keys the compiler cannot see (built at run time)
    s = strings.setdefault(k, {})
    if k in en:
        s.setdefault("localizations", {})["en"] = {"stringUnit": {"state": "translated", "value": en[k]}}
catalog.write_text(json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
missing = [k for k in sorted(keys) if "en" not in strings[k].get("localizations", {})]
print(json.dumps({k: "" for k in missing}, ensure_ascii=False, indent=1))
